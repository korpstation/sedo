# --- Serveur ---
PORT=3000
NODE_ENV=development

# --- Base de données ---
MONGO_URI=mongodb://localhost:27017/sedo

# --- JWT (générer des secrets longs et distincts, >= 64 caractères) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_REGISTRATION_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REGISTRATION_EXPIRES_IN=15m

# --- Emails (SendGrid) ---
SENDGRID_API_KEY=
EMAIL_FROM=noreply@sedo.app
ADMIN_EMAIL=admin@sedo.app

# --- URL applicative (liens email) ---
APP_URL=http://localhost:3000

# --- CORS (origines autorisées, séparées par des virgules — jamais de wildcard) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
